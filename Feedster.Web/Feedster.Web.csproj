<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-Feedster.Web-f4d4acc7-9645-4bbe-a6f1-6589fa8036df</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <!-- Enable only for migration tooling; keep Roslyn and design assemblies out of publish. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12"
                      PrivateAssets="all" Condition="'$(EnableEfTools)' == 'true'" />
    <ProjectReference Include="..\Feedster.DAL\Feedster.DAL.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Styles\**;scripts\**;package*.json;postcss.config.js;tailwind.config.js" />
    <Content Remove="wwwroot\css\open-iconic\**;wwwroot\fonts\**\*.eot;wwwroot\fonts\**\*.svg;wwwroot\fonts\**\*.ttf;wwwroot\fonts\**\*.woff" />
    <None Remove="database.db" />
  </ItemGroup>

  <Target Name="NpmInstall" Inputs="package.json;package-lock.json"
          Outputs="node_modules/.package-lock.json">
    <Exec Command="npm ci" />
  </Target>

  <Target Name="BuildCSS" BeforeTargets="BeforeBuild" DependsOnTargets="NpmInstall"
          Condition="'$(SkipCssBuild)' != 'true' and '$(RestoreExecuting)' != 'true'">
    <Exec Command="npm run buildcss:dev" Condition="'$(Configuration)' == 'Debug'" />
    <Exec Command="npm run buildcss:release" Condition="'$(Configuration)' != 'Debug'" />
  </Target>

  <Target Name="RemovePublishSourceMaps" AfterTargets="Publish">
    <ItemGroup>
      <PublishSourceMap Include="$(PublishDir)**/*.map;$(PublishDir)**/*.map.br;$(PublishDir)**/*.map.gz" />
    </ItemGroup>
    <Delete Files="@(PublishSourceMap)" />
  </Target>
</Project>
