@inherits LayoutComponentBase
@inject UserRepository UserRepository

<PageTitle>Feedster</PageTitle>
<CascadingValue Value="this" IsFixed="true">
    <div class="app-shell @(_isDarkMode ? "dark" : "")">
        <a href="#main-content" class="skip-link">Skip to content</a>
        <aside class="sidebar"><NavMenu @ref="_navMenu" /></aside>
        <main id="main-content" class="main-content" tabindex="-1" aria-busy="@(_interactive ? "false" : "true")">@Body</main>
    </div>
</CascadingValue>

@code {
    private bool _isDarkMode = true;
    private bool _interactive;
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) { _interactive = true; StateHasChanged(); }
    }
    private NavMenu? _navMenu;
    public async Task RefreshNavigation() { if (_navMenu is not null) await _navMenu.Refresh(); }
    protected override async Task OnInitializedAsync() => _isDarkMode = (await UserRepository.Get()).IsDarkMode;
    public void SetTheme(bool isDarkMode)
    {
        _isDarkMode = isDarkMode;
        StateHasChanged();
    }
}
