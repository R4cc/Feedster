@inject FolderRepository FolderRepository

<div class="sidebar-inner">
    <div class="brand-row">
        <a href="/" class="brand" aria-label="Feedster home"><span class="brand-mark"><Icon Name="rss" /></span><span>feedster<span class="brand-dot">.</span></span></a>
        <button type="button" class="icon-button menu-toggle" @onclick="() => _showSidebar = !_showSidebar" aria-label="@(_showSidebar ? "Close navigation" : "Open navigation")" aria-expanded="@(_showSidebar ? "true" : "false")" aria-controls="sidebar-navigation"><Icon Name="@(_showSidebar ? "close" : "menu")" /></button>
    </div>
    <nav id="sidebar-navigation" class="sidebar-navigation @(_showSidebar ? "is-open" : "")" aria-label="Main navigation">
        <p class="nav-label">Your library</p>
        <NavLink href="/" Match="NavLinkMatch.All" class="nav-link" @onclick="CloseMenu"><Icon Name="home" />All articles</NavLink>
        <NavLink href="feeds/manage" class="nav-link" @onclick="CloseMenu"><Icon Name="rss" />Manage feeds</NavLink>
        <NavLink href="folders/manage" class="nav-link" @onclick="CloseMenu"><Icon Name="folder" />Manage folders</NavLink>
        <div class="nav-section-heading"><p class="nav-label">Folders</p><a href="folders/manage" class="icon-button" aria-label="Manage folders"><Icon Name="plus" /></a></div>
        @if (_folders.Count == 0) { <p class="nav-empty">Organize your feeds into folders to make them easy to find.</p> }
        @foreach (var folder in _folders)
        {
            <div class="folder-navigation" @key="folder.FolderId">
                <div class="folder-navigation-row">
                    <NavLink href="@($"folder/{folder.FolderId}")" class="nav-link" @onclick="CloseMenu"><Icon Name="folder" /><span class="truncate" title="@folder.Name">@folder.Name</span><span class="nav-count">@folder.Feeds.Count</span></NavLink>
                    @if (folder.Feeds.Count > 0)
                    {
                        <button type="button" class="icon-button folder-toggle" aria-label="@($"Feeds in {folder.Name}")" aria-expanded="@(_expandedFolders.Contains(folder.FolderId) ? "true" : "false")" aria-controls="@($"folder-feeds-{folder.FolderId}")" @onclick="() => ToggleFolder(folder.FolderId)"><Icon Name="chevron" /></button>
                    }
                </div>
                @if (_expandedFolders.Contains(folder.FolderId))
                {
                    <div id="@($"folder-feeds-{folder.FolderId}")" class="folder-feed-links">
                        @foreach (var feed in folder.Feeds.OrderBy(f => f.Name))
                        {
                            <NavLink href="@($"feed/{feed.FeedId}")" class="nav-link" @onclick="CloseMenu"><span class="feed-dot"></span><span class="truncate" title="@feed.Name">@feed.Name</span></NavLink>
                        }
                    </div>
                }
            </div>
        }
        <div class="sidebar-footer"><NavLink href="settings" class="nav-link" @onclick="CloseMenu"><Icon Name="settings" />Settings</NavLink></div>
    </nav>
</div>

@code {
    private List<Folder> _folders = new();
    private readonly HashSet<int> _expandedFolders = new();
    private bool _showSidebar;
    protected override async Task OnInitializedAsync() => await Refresh();
    public async Task Refresh() { _folders = (await FolderRepository.GetAll()).OrderBy(f => f.Name).ToList(); StateHasChanged(); }
    private void CloseMenu() => _showSidebar = false;
    private void ToggleFolder(int id) { if (!_expandedFolders.Add(id)) _expandedFolders.Remove(id); }
}
