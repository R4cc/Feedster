@page "/feeds/manage"
@inject FeedRepository FeedRepository
@inject IJSRuntime Js

<PageTitle>Feedster · Manage feeds</PageTitle>
<PageHeader Title="Manage feeds"><button type="button" class="button button-primary" disabled="@_isBusy" @onclick="StartCreate"><Icon Name="plus" />Add feed</button></PageHeader>
@if (_feeds.Count == 0)
{
    <EmptyState Title="No feeds yet" Description="Add an RSS or Atom feed URL to start receiving articles."><button type="button" class="button button-primary" @onclick="StartCreate"><Icon Name="plus" />Add your first feed</button></EmptyState>
}
else
{
    <div class="collection-summary"><span>@_feeds.Count @(_feeds.Count == 1 ? "source" : "sources")</span><span>Updated automatically</span></div>
    <div class="table-surface"><table class="management-table"><caption class="sr-only">Your feed subscriptions</caption><thead><tr><th scope="col">Source</th><th scope="col">Feed URL</th><th scope="col">Actions</th></tr></thead><tbody>
        @foreach (var feed in _feeds)
        {
            <tr @key="feed.FeedId">
                <td data-label="Source"><a href="@($"feed/{feed.FeedId}")" class="table-name">@feed.Name</a></td>
                <td data-label="Feed URL"><span class="feed-url" title="@feed.RssUrl">@feed.RssUrl</span></td>
                <td data-label="Actions"><div class="row-actions">
                    <button type="button" class="button button-small button-secondary" disabled="@_isBusy" aria-label="@($"Edit {feed.Name}")" @onclick="() => StartEdit(feed)"><Icon Name="edit" />Edit</button>
                    <button type="button" class="button button-small button-secondary" disabled="@_isBusy" aria-label="@($"Update {feed.Name}")" @onclick="() => FetchFeed(feed)"><Icon Name="refresh" />@(_updatingId == feed.FeedId ? "Updating…" : "Update")</button>
                    <button type="button" class="icon-button danger-text" disabled="@_isBusy" aria-label="@($"Delete {feed.Name}")" title="Delete feed" @onclick="() => _feedToRemove = feed"><Icon Name="trash" /></button>
                </div></td>
            </tr>
        }
    </tbody></table></div>
}
<SlideOver Title="@(_editor.FeedId == -1 ? "Add a feed" : "Edit feed")">
    <EditForm Model="_editor" OnValidSubmit="SaveChanges" @key="_editor">
        <DataAnnotationsValidator />
        <p class="form-intro">Add the RSS or Atom URL for a source you want to follow.</p>
        <div class="form-field"><label for="feed-name">Name</label><InputText id="feed-name" @bind-Value="_editor.Name" maxlength="64" placeholder="e.g. Hacker News" autocomplete="off" /><ValidationMessage For="@(() => _editor.Name)" /></div>
        <div class="form-field"><label for="feed-url">RSS or Atom URL</label><InputText id="feed-url" @bind-Value="_editor.RssUrl" type="url" maxlength="512" placeholder="https://example.com/feed.xml" autocomplete="url" /><p class="field-help">Use the feed URL, rather than the website's home page.</p><ValidationMessage For="@(() => _editor.RssUrl)" /></div>
        <div class="form-actions"><button type="button" class="button button-secondary" onclick="closeSlideover()" disabled="@_isBusy">Cancel</button><button type="submit" class="button button-primary" disabled="@_isBusy">@(_isBusy ? "Saving…" : "Save feed")</button></div>
    </EditForm>
</SlideOver>
@if (_feedToRemove is not null) { <ConfirmationModal Title="Delete feed?" Summary="@($"Remove “{_feedToRemove.Name}” and its articles? This cannot be undone.")" OnUserSelection="DeleteConfirmed" /> }
@_notification

@code {
    [CascadingParameter] public MainLayout? Layout { get; set; }
    private List<Feed> _feeds = new();
    private Feed _editor = new() { FeedId = -1 };
    private Feed? _feedToRemove;
    private RenderFragment? _notification;
    private bool _isBusy;
    private int? _updatingId;
    protected override async Task OnInitializedAsync() => await LoadFeeds();
    private async Task LoadFeeds() => _feeds = (await FeedRepository.GetAll()).OrderBy(f => f.Name).ToList();
    private async Task StartCreate()
    {
        if (_isBusy) return;
        _editor = new() { FeedId = -1 };
        await Js.InvokeVoidAsync("toggleSlideover");
    }
    private async Task StartEdit(Feed feed)
    {
        if (_isBusy) return;
        _editor = new() { FeedId = feed.FeedId, Name = feed.Name, RssUrl = feed.RssUrl };
        await Js.InvokeVoidAsync("toggleSlideover");
    }
    private async Task SaveChanges()
    {
        if (_isBusy) return;
        _isBusy = true;
        try
        {
            Feed saved;
            if (_editor.FeedId == -1)
            {
                saved = new() { Name = _editor.Name.Trim(), RssUrl = _editor.RssUrl.Trim() };
                await FeedRepository.Create(saved);
                _editor.FeedId = saved.FeedId;
            }
            else
            {
                saved = _feeds.Single(f => f.FeedId == _editor.FeedId);
                saved.Name = _editor.Name.Trim(); saved.RssUrl = _editor.RssUrl.Trim();
                await FeedRepository.Update(saved);
            }
            await Js.InvokeVoidAsync("closeSlideover");
            await LoadFeeds();
            if (Layout is not null) await Layout.RefreshNavigation();
            Notify("Feed saved", "Fetching articles from your source…");
            var count = await FeedRepository.FetchFeed(saved);
            await LoadFeeds();
            ReportFetch(saved.Name, count);
        }
        catch { Notify("Could not save the feed", "Please try again. If the feed was saved, you can update it from the list.", NotificationType.Error); }
        finally { _isBusy = false; }
    }
    private async Task FetchFeed(Feed feed)
    {
        if (_isBusy) return;
        _isBusy = true; _updatingId = feed.FeedId;
        try { ReportFetch(feed.Name, await FeedRepository.FetchFeed(feed)); await LoadFeeds(); }
        catch { Notify("Update failed", "Please try again in a moment.", NotificationType.Error); }
        finally { _isBusy = false; _updatingId = null; }
    }
    private async Task DeleteConfirmed(bool confirmed)
    {
        var feed = _feedToRemove; _feedToRemove = null;
        if (!confirmed || feed is null || _isBusy) return;
        _isBusy = true;
        try
        {
            await FeedRepository.Remove(feed); await LoadFeeds();
            if (Layout is not null) await Layout.RefreshNavigation();
            Notify("Feed deleted", $"“{feed.Name}” was removed.", NotificationType.Success);
        }
        catch { Notify("Could not delete the feed", "Please try again.", NotificationType.Error); }
        finally { _isBusy = false; }
    }
    private void ReportFetch(string name, int? count)
    {
        if (count is null) Notify("Could not update the feed", $"“{name}” could not be fetched. Try again later.", NotificationType.Error);
        else Notify(count == 0 ? "You're up to date" : "New articles fetched", count == 0 ? $"No new articles from “{name}”." : $"{count} new articles from “{name}”.", NotificationType.Success);
    }
    private void Notify(string title, string summary, NotificationType type = NotificationType.Info) { var key = Guid.NewGuid(); _notification = @<Notification @key="key" Title="@title" Summary="@summary" Type="@type" />; }
}
