@page "/feed/{feedId:int}"
@inject FeedRepository FeedRepository

@if (_feed is not null)
{
    <PageTitle>Feedster · @_feed.Name</PageTitle>
    <PageHeader Title="@_feed.Name"><a href="feeds/manage" class="button button-secondary"><Icon Name="rss" />Manage feeds</a></PageHeader>
    <ArticlesList AllArticles="@(_feed.Articles ?? new())" />
}
else
{
    <PageTitle>Feedster · Feed not found</PageTitle>
    <PageHeader Title="Feed not found" />
    <EmptyState Title="Feed unavailable" Description="Browse your feeds or head back to all articles."><a href="feeds/manage" class="button button-primary">Manage feeds</a></EmptyState>
}
@code {
    [Parameter] public int FeedId { get; set; }
    private Feed? _feed;
    protected override async Task OnParametersSetAsync() => _feed = await FeedRepository.Get(FeedId);
}
