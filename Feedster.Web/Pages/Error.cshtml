@page
@model Feedster.Web.Pages.ErrorModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Feedster · Error</title>
    <link href="~/css/app.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" />
</head>
<body>
    <div class="app-shell error-page">
        <main class="main-content">
            <h1>Something went wrong</h1>
            <div class="empty-state">
                <h2>Could not load this page</h2>
                <p>Try again in a moment. If the problem continues, use the request ID below when reporting it.</p>
                @if (Model.ShowRequestId) { <p>Request ID: <code>@Model.RequestId</code></p> }
                <a href="/" class="button button-primary">Return to articles</a>
            </div>
        </main>
    </div>
</body>
</html>
