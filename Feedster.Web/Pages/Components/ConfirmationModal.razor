@implements IAsyncDisposable
@inject IJSRuntime Js
<dialog @ref="_dialog" class="confirmation-dialog" aria-labelledby="confirmation-title" aria-describedby="confirmation-summary">
    <div class="dialog-body"><span class="danger-icon"><Icon Name="trash" /></span><h2 id="confirmation-title">@Title</h2><p id="confirmation-summary">@Summary</p></div>
    <div class="dialog-actions"><button type="button" class="button button-secondary" autofocus @onclick="() => ClickButton(false)">Cancel</button><button type="button" class="button button-danger" disabled="@_isBusy" @onclick="() => ClickButton(true)">@(_isBusy ? "Please wait…" : "Confirm")</button></div>
</dialog>
@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Summary { get; set; } = string.Empty;
    [Parameter] public EventCallback<bool> OnUserSelection { get; set; }
    private ElementReference _dialog;
    private DotNetObjectReference<ConfirmationModal>? _reference;
    private bool _isBusy;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _reference = DotNetObjectReference.Create(this);
        await Js.InvokeVoidAsync("feedster.openConfirmation", _dialog, _reference);
    }
    [JSInvokable] public Task Cancel() => ClickButton(false);
    private async Task ClickButton(bool confirmed)
    {
        if (_isBusy) return;
        _isBusy = true;
        try
        {
            await Js.InvokeVoidAsync("feedster.closeDialog", _dialog);
            await OnUserSelection.InvokeAsync(confirmed);
        }
        finally { _isBusy = false; }
    }
    public async ValueTask DisposeAsync()
    {
        try { await Js.InvokeVoidAsync("feedster.closeDialog", _dialog); }
        catch (JSDisconnectedException) { }
        _reference?.Dispose();
    }
}
