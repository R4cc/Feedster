<dialog id="slideover" class="editor-dialog" aria-label="@Title">
    <div class="dialog-heading"><h2>@Title</h2><button type="button" class="icon-button" onclick="closeSlideover()" aria-label="Close editor"><Icon Name="close" /></button></div>
    <div class="dialog-body">@ChildContent</div>
</dialog>
@code {
    [Parameter] public string Title { get; set; } = "Edit details";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
