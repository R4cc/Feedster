@inject IJSRuntime Js
@inject UserRepository UserRepository

@if (AllArticles.Count == 0)
{
    <EmptyState Title="No articles yet" Description="Add an RSS or Atom feed to start receiving articles. Existing feeds can be refreshed from Manage feeds."><a href="feeds/manage" class="button button-primary"><Icon Name="plus" />Manage feeds</a></EmptyState>
}
else
{
    <div class="reading-toolbar">
        <p class="result-count" role="status">@_filtered.Count @(_filtered.Count == 1 ? "article" : "articles")<span> · Newest first</span></p>
        <div class="search-field"><Icon Name="search" /><input type="search" aria-label="Search articles" placeholder="Search your articles…" value="@_query" @oninput="SearchChanged" /></div>
    </div>
    @if (_filtered.Count == 0)
    {
        <EmptyState IconName="search" Title="No matching articles" Description="Try another title, source, or word from the article."><button type="button" class="button button-secondary" @onclick="ClearSearch">Clear search</button></EmptyState>
    }
    else
    {
        <div class="article-list">
            @foreach (var article in _filtered.Skip((_page - 1) * PageSize).Take(PageSize))
            {
                <article class="article-card" @key="article.ArticleId">
                    <div class="article-copy">
                        <div class="article-meta"><span class="source-badge">@(article.Feed?.Name ?? "Your feed")</span><time datetime="@article.PublicationDate.ToString("O")">@article.PublicationDate.ToString("MMM d, yyyy · HH:mm")</time></div>
                        <h2>
                            @if (HasSafeLink(article.ArticleLink))
                            {
                                <a href="@article.ArticleLink" target="_blank" rel="noopener noreferrer" class="article-link">@(!string.IsNullOrWhiteSpace(article.Title) ? article.Title : "Untitled article")<span class="sr-only"> (opens in a new tab)</span></a>
                            }
                            else { @(!string.IsNullOrWhiteSpace(article.Title) ? article.Title : "Untitled article") }
                        </h2>
                        @if (!string.IsNullOrWhiteSpace(article.Description)) { <p class="article-description">@article.Description</p> }
                        @if (HasSafeLink(article.ArticleLink)) { <span class="article-read-hint" aria-hidden="true">Read article <Icon Name="external" /></span> }
                    </div>
                    @if (_settings.ShowImages && !string.IsNullOrEmpty(article.ImagePath) && File.Exists("images/" + article.ImagePath))
                    {
                        <img src="@("images/" + article.ImagePath)" class="article-image" alt="" loading="lazy" decoding="async" />
                    }
                </article>
            }
        </div>
        @if (PageCount > 1)
        {
            <nav class="pagination" aria-label="Article pages">
                <button type="button" class="button button-secondary" disabled="@(_page <= 1)" @onclick="() => ChangePage(-1)"><span aria-hidden="true">←</span> Previous</button>
                <p role="status">Page @_page of @PageCount</p>
                <button type="button" class="button button-secondary" disabled="@(_page >= PageCount)" @onclick="() => ChangePage(1)">Next <Icon Name="arrow" /></button>
            </nav>
        }
    }
}

@code {
    [Parameter] public List<Article> AllArticles { get; set; } = new();
    private UserSettings _settings = new();
    private List<Article> _filtered = new();
    private string _query = string.Empty;
    private int _page = 1;
    private List<Article>? _previousArticles;
    private int PageSize => _settings.ArticleCountOnPage <= 0 ? Math.Max(1, _filtered.Count) : _settings.ArticleCountOnPage;
    private int PageCount => Math.Max(1, (int)Math.Ceiling((double)_filtered.Count / PageSize));
    protected override async Task OnInitializedAsync() => _settings = await UserRepository.Get();
    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(AllArticles, _previousArticles)) { _page = 1; _query = string.Empty; _previousArticles = AllArticles; }
        FilterArticles();
    }
    private void SearchChanged(ChangeEventArgs e) { _query = e.Value?.ToString() ?? string.Empty; _page = 1; FilterArticles(); }
    private void ClearSearch() { _query = string.Empty; _page = 1; FilterArticles(); }
    private void FilterArticles()
    {
        var query = _query.Trim();
        _filtered = AllArticles.Where(a => query.Length == 0 || Contains(a.Title, query) || Contains(a.Description, query) || Contains(a.Feed?.Name, query)).OrderByDescending(a => a.PublicationDate).ThenByDescending(a => a.ArticleId).ToList();
        _page = Math.Clamp(_page, 1, PageCount);
    }
    private static bool Contains(string? text, string query) => text?.Contains(query, StringComparison.OrdinalIgnoreCase) == true;
    private static bool HasSafeLink(string link) => Uri.TryCreate(link, UriKind.Absolute, out var uri) && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps);
    private async Task ChangePage(int direction)
    {
        _page = Math.Clamp(_page + direction, 1, PageCount);
        await Js.InvokeVoidAsync("OnScrollEvent");
    }
}
