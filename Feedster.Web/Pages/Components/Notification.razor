@if (IsShown)
{
    <div class="notification notification-@Type.ToString().ToLowerInvariant()" role="@(Type == NotificationType.Error ? "alert" : "status")" aria-atomic="true">
        <span class="notification-icon"><Icon Name="@(Type == NotificationType.Success ? "check" : "info")" /></span>
        <div><p class="notification-title">@Title</p><p>@Summary</p></div>
        <button type="button" class="icon-button" aria-label="Dismiss notification" @onclick="() => IsShown = false"><Icon Name="close" /></button>
    </div>
}
@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Summary { get; set; } = string.Empty;
    [Parameter] public bool IsShown { get; set; } = true;
    [Parameter] public NotificationType Type { get; set; } = NotificationType.Info;
}
