@page "/settings"
@implements IDisposable
@inject UserRepository UserRepository
@inject ImageService ImageService
@inject ArticleRepository ArticleRepository
@inject NavigationManager NavigationManager
@inject HttpClient HttpClient

<PageTitle>Feedster · Settings</PageTitle>
<PageHeader Title="Settings" />
@if (_editContext is not null)
{
    <EditForm EditContext="_editContext" OnValidSubmit="SaveChanges">
        <DataAnnotationsValidator />
        <div class="settings-grid">
            <section class="settings-section"><div class="section-heading"><Icon Name="rss" /><div><h2>Reading preferences</h2></div></div>
                <div class="form-field"><label for="refresh-interval">Check for new articles</label><InputSelect id="refresh-interval" @bind-Value="_settings.ArticleRefreshAfterMinutes">
                    @if (!new[] { 0, 5, 10, 15, 30, 60, 360, 1440 }.Contains(_settings.ArticleRefreshAfterMinutes)) { <option value="@_settings.ArticleRefreshAfterMinutes">Every @_settings.ArticleRefreshAfterMinutes minutes</option> }
                    <option value="5">Every 5 minutes</option><option value="10">Every 10 minutes</option><option value="15">Every 15 minutes</option><option value="30">Every 30 minutes</option><option value="60">Every hour</option><option value="360">Every 6 hours</option><option value="1440">Every day</option><option value="0">Manually only</option>
                </InputSelect></div>
                <div class="form-field"><label for="article-expiration">Remove articles older than</label><InputSelect id="article-expiration" @bind-Value="_settings.ArticleExpirationAfterDays">
                    @if (!new[] { 0, 7, 14, 30, 90, 180, 365 }.Contains(_settings.ArticleExpirationAfterDays)) { <option value="@_settings.ArticleExpirationAfterDays">@_settings.ArticleExpirationAfterDays days</option> }
                    <option value="7">1 week</option><option value="14">2 weeks</option><option value="30">1 month</option><option value="90">3 months</option><option value="180">6 months</option><option value="365">1 year</option><option value="0">Keep all articles</option>
                </InputSelect></div>
                <div class="form-field"><label for="page-size">Articles per page</label><InputNumber id="page-size" @bind-Value="_settings.ArticleCountOnPage" min="0" step="1" aria-describedby="page-size-help" /><p id="page-size-help" class="field-help">Set to 0 to show all articles on one page.</p><ValidationMessage For="@(() => _settings.ArticleCountOnPage)" /></div>
            </section>
            <section class="settings-section"><div class="section-heading"><Icon Name="settings" /><div><h2>Appearance &amp; images</h2></div></div>
                <label class="setting-toggle" for="dark-mode"><span><strong>Dark mode</strong><small>Preview your theme as you switch.</small></span><InputCheckbox id="dark-mode" class="switch" @bind-Value="_settings.IsDarkMode" /></label>
                <label class="setting-toggle" for="show-images"><span><strong>Show article images</strong><small>Display thumbnails in your reading list.</small></span><InputCheckbox id="show-images" class="switch" @bind-Value="_settings.ShowImages" /></label>
                <label class="setting-toggle" for="download-images"><span><strong>Download article images</strong><small>Cache images locally when feeds update.</small></span><InputCheckbox id="download-images" class="switch" @bind-Value="_settings.DownloadImages" /></label>
                <p class="field-help">Save your changes to keep these preferences.</p>
            </section>
            <section class="settings-section"><div class="section-heading"><Icon Name="folder" /><div><h2>Storage</h2></div></div>
                <div class="storage-row"><div><strong>Image cache</strong><span class="storage-size">@FormatSize(_imageSize)</span></div><button type="button" class="button button-small button-secondary" disabled="@_isBusy" @onclick="() => _clearTarget = ClearTarget.Images"><Icon Name="trash" />Clear</button></div>
                <div class="storage-row"><div><strong>Article database</strong><span class="storage-size">@FormatSize(_databaseSize)</span></div><button type="button" class="button button-small button-secondary" disabled="@_isBusy" @onclick="() => _clearTarget = ClearTarget.Articles"><Icon Name="trash" />Clear articles</button></div>
                <p class="field-help">Database size includes settings and subscriptions. Clearing articles may leave reusable space in the database file.</p>
            </section>
            <section class="settings-section"><div class="section-heading"><Icon Name="upload" /><div><h2>Import &amp; export</h2></div></div>
                <div class="form-field"><label for="opml-file">Import subscriptions</label><InputFile id="opml-file" OnChange="ImportOpml" accept=".opml,.xml" disabled="@_isBusy" /><p class="field-help">Choose an OPML file, up to 10 MB.</p></div>
                <a href="api/Opml/export" class="button button-secondary" download><Icon Name="download" />Export OPML</a>
            </section>
        </div>
        <div class="settings-savebar"><p role="status">@(_isSaving ? "Saving your preferences…" : _hasChanges ? "You have unsaved changes." : "Your preferences are up to date.")</p><button type="submit" class="button button-primary" disabled="@(!_hasChanges || _isBusy)"><Icon Name="check" />@(_isSaving ? "Saving…" : "Save changes")</button></div>
    </EditForm>
}
@if (_clearTarget is not null) { <ConfirmationModal Title="@(_clearTarget == ClearTarget.Images ? "Clear image cache?" : "Clear all articles?")" Summary="@(_clearTarget == ClearTarget.Images ? "Downloaded images will be removed. Your feeds and articles will stay in your library." : "All saved articles will be removed. Your feeds and folders will stay in your library. This cannot be undone.")" OnUserSelection="ClearConfirmed" /> }
@_notification

@code {
    [CascadingParameter] public MainLayout? Layout { get; set; }
    private UserSettings _settings = new();
    private UserSettings? _storedSettings;
    private EditContext? _editContext;
    private bool _hasChanges;
    private bool _isSaving;
    private bool _isBusy;
    private bool _savedDarkMode;
    private long _imageSize;
    private long _databaseSize;
    private ClearTarget? _clearTarget;
    private RenderFragment? _notification;
    private enum ClearTarget { Images, Articles }
    protected override async Task OnInitializedAsync()
    {
        _storedSettings = await UserRepository.Get();
        _savedDarkMode = _storedSettings.IsDarkMode;
        _settings = new() {
            UserSettingsId = _storedSettings.UserSettingsId, ArticleRefreshAfterMinutes = _storedSettings.ArticleRefreshAfterMinutes,
            ArticleExpirationAfterDays = _storedSettings.ArticleExpirationAfterDays, ArticleCountOnPage = _storedSettings.ArticleCountOnPage,
            MaxArticleCountInDb = _storedSettings.MaxArticleCountInDb, ShowImages = _storedSettings.ShowImages,
            DownloadImages = _storedSettings.DownloadImages, IsDarkMode = _storedSettings.IsDarkMode
        };
        _editContext = new(_settings);
        _editContext.OnFieldChanged += FieldChanged;
        LoadSizes();
    }
    private void FieldChanged(object? sender, FieldChangedEventArgs args)
    {
        _hasChanges = true;
        if (args.FieldIdentifier.FieldName == nameof(UserSettings.IsDarkMode)) Layout?.SetTheme(_settings.IsDarkMode);
    }
    private void LoadSizes() { _imageSize = ImageService.GetImageCacheFolderSize(); _databaseSize = ImageService.GetDatabaseSize(); }
    private static string FormatSize(long size) => size == 0 ? "< 1 MB" : $"{size:N0} MB";
    private async Task SaveChanges()
    {
        if (_isBusy || _storedSettings is null) return;
        _isBusy = true; _isSaving = true;
        try
        {
            _storedSettings.ArticleRefreshAfterMinutes = _settings.ArticleRefreshAfterMinutes;
            _storedSettings.ArticleExpirationAfterDays = _settings.ArticleExpirationAfterDays;
            _storedSettings.ArticleCountOnPage = _settings.ArticleCountOnPage;
            _storedSettings.ShowImages = _settings.ShowImages; _storedSettings.DownloadImages = _settings.DownloadImages;
            _storedSettings.IsDarkMode = _settings.IsDarkMode;
            await UserRepository.Update(_storedSettings);
            _savedDarkMode = _settings.IsDarkMode; _hasChanges = false; _editContext?.MarkAsUnmodified();
            Notify("Preferences saved", "Your changes are saved. Scheduling changes may take up to 10 minutes to apply.", NotificationType.Success);
        }
        catch { Notify("Could not save preferences", "Your changes are still here. Please try again.", NotificationType.Error); }
        finally { _isBusy = false; _isSaving = false; }
    }
    private async Task ClearConfirmed(bool confirmed)
    {
        var target = _clearTarget; _clearTarget = null;
        if (!confirmed || target is null || _isBusy) return;
        _isBusy = true;
        try
        {
            if (target == ClearTarget.Images) ImageService.ClearImageCache(); else await ArticleRepository.ClearAllArticles();
            LoadSizes();
            Notify(target == ClearTarget.Images ? "Image cache cleared" : "Articles cleared", "Your subscriptions and folders are unchanged.", NotificationType.Success);
        }
        catch { Notify("Could not clear the cache", "Please try again.", NotificationType.Error); }
        finally { _isBusy = false; }
    }
    private async Task ImportOpml(InputFileChangeEventArgs args)
    {
        if (_isBusy) return;
        _isBusy = true;
        try
        {
            using var content = new MultipartFormDataContent();
            await using var stream = args.File.OpenReadStream(10 * 1024 * 1024);
            content.Add(new StreamContent(stream), "file", args.File.Name);
            using var response = await HttpClient.PostAsync(NavigationManager.ToAbsoluteUri("api/Opml/import"), content);
            if (response.IsSuccessStatusCode)
            {
                if (Layout is not null) await Layout.RefreshNavigation();
                Notify("Subscriptions imported", "Your feeds are ready in the library.", NotificationType.Success);
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Notify("Import failed", string.IsNullOrWhiteSpace(error) ? "Check your OPML file and try again." : error, NotificationType.Error);
            }
        }
        catch { Notify("Import failed", "Choose a valid OPML file smaller than 10 MB and try again.", NotificationType.Error); }
        finally { _isBusy = false; }
    }
    private void Notify(string title, string summary, NotificationType type) { var key = Guid.NewGuid(); _notification = @<Notification @key="key" Title="@title" Summary="@summary" Type="@type" />; }
    public void Dispose()
    {
        if (_editContext is not null) _editContext.OnFieldChanged -= FieldChanged;
        if (_hasChanges) Layout?.SetTheme(_savedDarkMode);
    }
}
