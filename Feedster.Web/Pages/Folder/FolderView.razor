@page "/folder/{folderId:int}"
@inject FolderRepository FolderRepository
@inject FeedRepository FeedRepository
@inject ArticleRepository ArticleRepository
@inject IJSRuntime Js

@if (_folder is not null)
{
    <PageTitle>Feedster · @_folder.Name</PageTitle>
    <PageHeader Title="@_folder.Name"><button type="button" class="button button-secondary" disabled="@_isSaving" @onclick="StartEdit"><Icon Name="edit" />Edit folder</button></PageHeader>
    @if (_folder.Feeds.Count == 0)
    {
        <EmptyState IconName="folder" Title="No feeds in this folder" Description="Choose sources for this folder to start reading their articles here."><button type="button" class="button button-primary" @onclick="StartEdit"><Icon Name="plus" />Choose feeds</button></EmptyState>
    }
    else { <ArticlesList AllArticles="@_articles" /> }
    <SlideOver Title="Edit folder"><EditForm Model="_editor" OnValidSubmit="SaveChanges" @key="_editor"><DataAnnotationsValidator /><FolderFields Model="_editor" Feeds="_feeds" /><div class="form-actions"><button type="button" class="button button-secondary" onclick="closeSlideover()" disabled="@_isSaving">Cancel</button><button type="submit" class="button button-primary" disabled="@_isSaving">@(_isSaving ? "Saving…" : "Save folder")</button></div></EditForm></SlideOver>
}
else
{
    <PageTitle>Feedster · Folder not found</PageTitle><PageHeader Title="Folder not found" /><EmptyState IconName="folder" Title="Folder unavailable" Description="Browse your folders or return to all articles."><a href="folders/manage" class="button button-primary">Manage folders</a></EmptyState>
}
@_notification
@code {
    [Parameter] public int FolderId { get; set; }
    [CascadingParameter] public MainLayout? Layout { get; set; }
    private Folder? _folder;
    private Folder _editor = new();
    private List<Feed> _feeds = new();
    private List<Article> _articles = new();
    private bool _isSaving;
    private RenderFragment? _notification;
    protected override async Task OnParametersSetAsync()
    {
        _folder = (await FolderRepository.GetAll()).SingleOrDefault(f => f.FolderId == FolderId);
        _articles = _folder is null ? new() : await ArticleRepository.GetFromFolderId(FolderId);
        _feeds = await FeedRepository.GetAll();
    }
    private async Task StartEdit()
    {
        if (_folder is null || _isSaving) return;
        _editor = new() { FolderId = _folder.FolderId, Name = _folder.Name, Feeds = _folder.Feeds.ToList() };
        await Js.InvokeVoidAsync("toggleSlideover");
    }
    private void Notify(string title, string summary, NotificationType type) { var key = Guid.NewGuid(); _notification = @<Notification @key="key" Title="@title" Summary="@summary" Type="@type" />; }
    private async Task SaveChanges()
    {
        if (_folder is null || _isSaving) return;
        _isSaving = true;
        try
        {
            _folder.Name = _editor.Name.Trim(); _folder.Feeds = _editor.Feeds.ToList();
            await FolderRepository.Update(_folder);
            _articles = await ArticleRepository.GetFromFolderId(FolderId);
            if (Layout is not null) await Layout.RefreshNavigation();
            await Js.InvokeVoidAsync("closeSlideover");
            Notify("Folder saved", "Your changes are saved.", NotificationType.Success);
        }
        catch { Notify("Could not save the folder", "Please try again.", NotificationType.Error); }
        finally { _isSaving = false; }
    }
}
