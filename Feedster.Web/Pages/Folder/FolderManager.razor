@page "/folders/manage"
@inject FolderRepository FolderRepository
@inject FeedRepository FeedRepository
@inject IJSRuntime Js

<PageTitle>Feedster · Manage folders</PageTitle>
<PageHeader Title="Manage folders"><button type="button" class="button button-primary" disabled="@_isSaving" @onclick="StartCreate"><Icon Name="plus" />Add folder</button></PageHeader>
@if (_folders.Count == 0)
{
    <EmptyState IconName="folder" Title="No folders yet" Description="Create a folder and select its feeds. A feed can belong to more than one folder."><button type="button" class="button button-primary" @onclick="StartCreate"><Icon Name="plus" />Create your first folder</button></EmptyState>
}
else
{
    <div class="collection-summary"><span>@_folders.Count @(_folders.Count == 1 ? "folder" : "folders")</span></div>
    <div class="table-surface"><table class="management-table"><caption class="sr-only">Your folders</caption><thead><tr><th scope="col">Folder</th><th scope="col">Sources</th><th scope="col">Actions</th></tr></thead><tbody>
        @foreach (var folder in _folders)
        {
            <tr @key="folder.FolderId"><td data-label="Folder"><a class="table-name" href="@($"folder/{folder.FolderId}")">@folder.Name</a></td><td data-label="Sources"><span class="count-badge">@folder.Feeds.Count @(folder.Feeds.Count == 1 ? "feed" : "feeds")</span></td><td data-label="Actions"><div class="row-actions"><button type="button" class="button button-small button-secondary" disabled="@_isSaving" aria-label="@($"Edit {folder.Name}")" @onclick="() => StartEdit(folder)"><Icon Name="edit" />Edit</button><button type="button" class="icon-button danger-text" disabled="@_isSaving" aria-label="@($"Delete {folder.Name}")" title="Delete folder" @onclick="() => _folderToRemove = folder"><Icon Name="trash" /></button></div></td></tr>
        }
    </tbody></table></div>
}
<SlideOver Title="@(_editor.FolderId == -1 ? "Create a folder" : "Edit folder")">
    <EditForm Model="_editor" OnValidSubmit="SaveChanges" @key="_editor"><DataAnnotationsValidator /><p class="form-intro">Give your folder a name and choose the feeds you want to read together.</p><FolderFields Model="_editor" Feeds="_feeds" /><div class="form-actions"><button type="button" class="button button-secondary" onclick="closeSlideover()" disabled="@_isSaving">Cancel</button><button type="submit" class="button button-primary" disabled="@_isSaving">@(_isSaving ? "Saving…" : "Save folder")</button></div></EditForm>
</SlideOver>
@if (_folderToRemove is not null) { <ConfirmationModal Title="Delete folder?" Summary="@($"Remove “{_folderToRemove.Name}”? Your feeds and articles will stay in your library.")" OnUserSelection="DeleteConfirmed" /> }
@_notification

@code {
    [CascadingParameter] public MainLayout? Layout { get; set; }
    private List<Folder> _folders = new();
    private List<Feed> _feeds = new();
    private Folder _editor = new() { FolderId = -1 };
    private Folder? _folderToRemove;
    private bool _isSaving;
    private RenderFragment? _notification;
    protected override async Task OnInitializedAsync() { await LoadFolders(); _feeds = await FeedRepository.GetAll(); }
    private async Task LoadFolders() => _folders = (await FolderRepository.GetAll()).OrderBy(f => f.Name).ToList();
    private async Task StartCreate() { if (_isSaving) return; _editor = new() { FolderId = -1 }; await Js.InvokeVoidAsync("toggleSlideover"); }
    private async Task StartEdit(Folder folder) { if (_isSaving) return; _editor = new() { FolderId = folder.FolderId, Name = folder.Name, Feeds = folder.Feeds.ToList() }; await Js.InvokeVoidAsync("toggleSlideover"); }
    private async Task SaveChanges()
    {
        if (_isSaving) return;
        _isSaving = true;
        try
        {
            if (_editor.FolderId == -1)
            {
                var folder = new Folder { Name = _editor.Name.Trim(), Feeds = _editor.Feeds.ToList() };
                await FolderRepository.Create(folder); _editor.FolderId = folder.FolderId;
            }
            else
            {
                var folder = _folders.Single(f => f.FolderId == _editor.FolderId);
                folder.Name = _editor.Name.Trim(); folder.Feeds = _editor.Feeds.ToList();
                await FolderRepository.Update(folder);
            }
            await LoadFolders();
            if (Layout is not null) await Layout.RefreshNavigation();
            await Js.InvokeVoidAsync("closeSlideover");
            Notify("Folder saved", "The folder was saved.", NotificationType.Success);
        }
        catch { Notify("Could not save the folder", "Please try again.", NotificationType.Error); }
        finally { _isSaving = false; }
    }
    private async Task DeleteConfirmed(bool confirmed)
    {
        var folder = _folderToRemove; _folderToRemove = null;
        if (!confirmed || folder is null || _isSaving) return;
        _isSaving = true;
        try
        {
            await FolderRepository.Remove(folder); await LoadFolders();
            if (Layout is not null) await Layout.RefreshNavigation();
            Notify("Folder deleted", "Your feeds and articles are still in your library.", NotificationType.Success);
        }
        catch { Notify("Could not delete the folder", "Please try again.", NotificationType.Error); }
        finally { _isSaving = false; }
    }
    private void Notify(string title, string summary, NotificationType type) { var key = Guid.NewGuid(); _notification = @<Notification @key="key" Title="@title" Summary="@summary" Type="@type" />; }
}
