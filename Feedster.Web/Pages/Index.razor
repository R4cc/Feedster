@page "/"
@inject ArticleRepository ArticleRepository

<PageTitle>Feedster · All articles</PageTitle>
<PageHeader Title="All articles"><a href="feeds/manage" class="button button-secondary"><Icon Name="plus" />Add a feed</a></PageHeader>
<ArticlesList AllArticles="@_articles" />

@code {
    private List<Article> _articles = new();
    protected override async Task OnInitializedAsync() => _articles = await ArticleRepository.GetAll();
}
